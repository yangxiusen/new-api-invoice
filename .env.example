# This must point to the SAME New API database, with a dedicated restricted runtime role.
DATABASE_URL=postgres://invoice_runtime:CHANGE_ME@database:5432/new-api?sslmode=require
NEW_API_INTERNAL_URL=http://new-api:3000
PUBLIC_ORIGIN=https://api.example.com
INVOICE_FILE_ROOT=/data/invoices
LISTEN_ADDR=:3001
AUTH_TIMEOUT=3s
READ_ONLY_MODE=false
# Replace only after confirming the real payment provider/method currency semantics.
PAYMENT_CURRENCY_RULES=[{"provider":"CONFIRMED_PROVIDER","method":"CONFIRMED_METHOD","currency":"CNY"}]

# First startup creates Invoice-owned tables. Disable for explicit migrations only.
AUTO_MIGRATE=true
# Optional DDL account for the SAME host/port/database; opened only if not ready.
# Leave empty if DATABASE_URL itself has CREATE privileges on first installation.
MIGRATION_DATABASE_URL=
